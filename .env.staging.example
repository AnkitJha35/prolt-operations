# ==============================================================================
# Prolt-Operations Local Staging Environment Variables Template
# Copy to .env.staging and set actual staging values.
# DO NOT commit .env.staging to source control.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=prolt_staging
POSTGRES_USER=prolt_staging_user
POSTGRES_PASSWORD=replace_with_staging_db_password

# Redis Configuration (Redis 7)
REDIS_PASSWORD=replace_with_staging_redis_password

# Application Secrets & Authentication
JWT_SECRET=replace_with_at_least_32_bytes_staging_jwt_secret
ADMIN_USERNAME=stagingadmin
ADMIN_EMAIL=stagingadmin@proltenergy.test
ADMIN_PASSWORD=replace_with_min_12_chars_admin_password

# Playwright & Browser Runtime
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Security & CORS
CORS_ORIGIN=http://127.0.0.1:8089
NODE_ENV=staging
